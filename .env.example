# Copie este arquivo para .env apenas no ambiente local.
# Nunca coloque valores reais de chaves ou senhas no GitHub.

NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Credenciais do Supabase: configure as duas juntas, somente no servidor.
SUPABASE_URL=
# Use a Secret key (sb_secret_...) ou a chave service_role legada. Nunca use anon/public.
SUPABASE_SECRET_KEY=

# A geração por IA permanece desligada nesta etapa.
OPENAI_ENABLED=false
